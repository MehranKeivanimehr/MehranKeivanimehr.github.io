---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages %}
  {%- if p.layout == "default" and p.sitemap != false %}
  <url>
    <loc>{{ p.url | replace: "index.html", "" | prepend: site.baseurl | prepend: site.url }}</loc>
    <lastmod>{{ site.time | date: "%Y-%m-%d" }}</lastmod>
  </url>
  {%- endif %}
{%- endfor %}
{%- for extra in site.extra_sitemap_urls %}
  <url>
    <loc>{{ extra }}</loc>
  </url>
{%- endfor %}
</urlset>
